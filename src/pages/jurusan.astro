---
import Layout from '../layouts/Layout.astro';
// Import komponen Image dan file gambarnya
import { Image } from 'astro:assets';
import bannerJurusan from '../assets/images/Jurusan AIBS.jpg';

const jurusan = [
  {
    id: 'coding',
    title: 'AI Programmer',
    icon: '💻',
    desc: 'Belajar membuat website, aplikasi, dan solusi AI modern.',
    skills: ['Web Development', 'App Development', 'Machine Learning', 'LLM & Prompt Engineering'],
  },
  {
    id: 'design',
    title: 'AI Bisnis Digital',
    icon: '🎨',
    desc: 'Belajar desain, konten kreatif, digital marketing, dan bisnis berbasis AI.',
    skills: ['Generative Design', 'Konten Kreatif AI', 'Digital Marketing', 'Bisnis Berbasis AI'],
  },
  {
    id: 'cybersecurity',
    title: 'Keamanan Siber',
    icon: '🛡️',
    desc: 'Belajar keamanan jaringan, ethical hacking, dan digital forensik berbasis AI.',
    skills: ['Keamanan Jaringan', 'Ethical Hacking', 'Digital Forensik', 'Security Automation AI'],
  },
];
---

<Layout
  title="Jurusan"
  description="Tiga jurusan unggulan AIBS: AI Programmer, AI Bisnis Digital, dan Keamanan Siber."
>
  <!-- Banner Gambar -->
  <Image src={bannerJurusan} alt="Banner Jurusan SMK AIBS" class="w-full h-auto object-cover" />

  <section class="bg-brand-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900">Jurusan Kami</h1>
      <p class="mt-4 text-lg text-gray-600">Pilih jalur karier AI yang sesuai dengan minatmu.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16 space-y-10">
    {jurusan.map((j) => (
      <div id={j.id} class="scroll-mt-20 rounded-3xl border border-gray-100 p-6 sm:p-8 grid md:grid-cols-3 gap-6">
        <div class="md:col-span-1">
          <div class="text-5xl mb-3">{j.icon}</div>
          <h2 class="text-2xl font-bold text-gray-900">{j.title}</h2>
        </div>
        <div class="md:col-span-2">
          <p class="text-gray-600">{j.desc}</p>
          <h3 class="font-semibold text-gray-900 mt-5 mb-2">Yang akan kamu pelajari:</h3>
          <ul class="grid sm:grid-cols-2 gap-2">
            {j.skills.map((s) => (
              <li class="flex items-center gap-2 text-sm text-gray-700">
                <span class="text-brand-600">✓</span> {s}
              </li>
            ))}
          </ul>
          <a href="/ppdb" class="inline-block mt-6 bg-brand-600 text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-brand-700">
            Daftar Jurusan Ini
          </a>
        </div>
      </div>
    ))}
  </section>
</Layout>