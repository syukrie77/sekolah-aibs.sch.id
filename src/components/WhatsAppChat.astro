---
import site from '../data/site.json';
const wa = site.whatsapp;
---

<div id="wa-chat" class="fixed bottom-5 right-5 z-50">
  <!-- Chat panel -->
  <div
    id="wa-panel"
    class="hidden mb-3 w-80 max-w-[calc(100vw-2.5rem)] rounded-2xl bg-white shadow-2xl ring-1 ring-black/5 overflow-hidden"
  >
    <div class="bg-[#075E54] px-4 py-3 text-white">
      <p class="font-semibold">Asisten PPDB AIBS</p>
      <p class="text-xs text-green-100">Biasanya membalas dalam beberapa menit</p>
    </div>
    <div class="p-4 space-y-3 max-h-72 overflow-y-auto bg-[#ECE5DD]" id="wa-messages">
      <div class="bg-white rounded-lg rounded-tl-none px-3 py-2 text-sm text-gray-700 shadow-sm w-fit max-w-[85%]">
        Halo! 👋 Saya asisten AI penerimaan siswa baru AIBS. Ada yang bisa saya bantu seputar PPDB atau jurusan kami?
      </div>
    </div>
    <div class="p-3 border-t bg-white">
      <p class="text-xs text-gray-500 mb-2">Pertanyaan cepat:</p>
      <div class="flex flex-wrap gap-2 mb-3">
        <button class="wa-quick text-xs bg-brand-50 text-brand-700 px-2.5 py-1 rounded-full hover:bg-brand-100" data-msg="Saya ingin mendaftar PPDB AIBS">Cara daftar PPDB</button>
        <button class="wa-quick text-xs bg-brand-50 text-brand-700 px-2.5 py-1 rounded-full hover:bg-brand-100" data-msg="Berapa biaya pendaftaran di AIBS?">Biaya sekolah</button>
        <button class="wa-quick text-xs bg-brand-50 text-brand-700 px-2.5 py-1 rounded-full hover:bg-brand-100" data-msg="Apa saja jurusan yang tersedia di AIBS?">Jurusan</button>
      </div>
      <form id="wa-form" class="flex gap-2">
        <input
          id="wa-input"
          type="text"
          placeholder="Tulis pesan..."
          class="flex-1 rounded-full border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
        <button type="submit" class="bg-[#25D366] text-white rounded-full px-4 py-2 text-sm font-medium hover:bg-[#1faa52]">
          Kirim
        </button>
      </form>
    </div>
  </div>

  <!-- Toggle button -->
  <button
    id="wa-toggle"
    aria-label="Chat WhatsApp"
    class="flex items-center gap-2 bg-[#25D366] text-white rounded-full pl-3 pr-4 py-3 shadow-lg hover:bg-[#1faa52] transition"
  >
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
    </svg>
    <span class="hidden sm:inline text-sm font-medium">Chat AI PPDB</span>
  </button>
</div>

<script define:vars={{ wa }}>
  const toggle = document.getElementById('wa-toggle');
  const panel = document.getElementById('wa-panel');
  const form = document.getElementById('wa-form');
  const input = document.getElementById('wa-input');
  const messages = document.getElementById('wa-messages');

  toggle?.addEventListener('click', () => panel?.classList.toggle('hidden'));

  function addUserBubble(text) {
    const el = document.createElement('div');
    el.className =
      'bg-[#DCF8C6] rounded-lg rounded-tr-none px-3 py-2 text-sm text-gray-800 shadow-sm w-fit max-w-[85%] ml-auto';
    el.textContent = text;
    messages?.appendChild(el);
  }

  function addBotBubble(text) {
    const el = document.createElement('div');
    el.className =
      'bg-white rounded-lg rounded-tl-none px-3 py-2 text-sm text-gray-700 shadow-sm w-fit max-w-[85%]';
    el.textContent = text;
    messages?.appendChild(el);
    messages.scrollTop = messages.scrollHeight;
  }

  // Simple AI-style rule-based reply for the on-site assistant.
  function aiReply(msg) {
    const m = msg.toLowerCase();
    if (m.includes('daftar') || m.includes('ppdb'))
      return 'Pendaftaran PPDB AIBS dilakukan online. Klik tombol "Lanjut ke WhatsApp" dan tim kami akan memandu langkah demi langkah. 😊';
    if (m.includes('biaya'))
      return 'Biaya pendaftaran terjangkau dan tersedia skema beasiswa. Untuk rincian terbaru, lanjutkan chat ke admin via WhatsApp.';
    if (m.includes('jurusan') || m.includes('coding') || m.includes('design') || m.includes('cyber') || m.includes('marketing'))
      return 'Kami punya 3 jurusan: AI Programmer, AI Bisnis Digital, dan Keamanan Siber. Mau saya jelaskan salah satunya?';



    return 'Terima kasih atas pertanyaannya! Untuk jawaban lengkap, silakan lanjut ke WhatsApp admin kami ya.';
  }

  function handleMessage(text) {
    if (!text) return;
    addUserBubble(text);
    messages.scrollTop = messages.scrollHeight;
    setTimeout(() => {
      addBotBubble(aiReply(text));
      const link = document.createElement('a');
      link.href = `https://wa.me/${wa}?text=${encodeURIComponent(text)}`;
      link.target = '_blank';
      link.rel = 'noopener';
      link.className =
        'block mt-1 text-center bg-[#25D366] text-white rounded-lg px-3 py-2 text-xs font-medium hover:bg-[#1faa52] w-fit';
      link.textContent = 'Lanjut ke WhatsApp →';
      messages?.appendChild(link);
      messages.scrollTop = messages.scrollHeight;
    }, 500);
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    input.value = '';
    handleMessage(text);
  });

  document.querySelectorAll('.wa-quick').forEach((btn) => {
    btn.addEventListener('click', () => handleMessage(btn.getAttribute('data-msg')));
  });
</script>
