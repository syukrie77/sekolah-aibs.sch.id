---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
// Import komponen Image dan file gambarnya
import { Image } from 'astro:assets';
import bannerPpdb from '../assets/images/PPDB AIBS.jpg';

const steps = [
  { n: '1', title: 'Konsultasi', desc: 'Chat AI PPDB kami untuk memilih jurusan yang tepat.' },
  { n: '2', title: 'Isi Formulir', desc: 'Lengkapi data diri dan pilihan jurusan.' },
  { n: '3', title: 'Seleksi', desc: 'Tes minat & bakat ringan secara online.' },
  { n: '4', title: 'Diterima', desc: 'Selamat bergabung menjadi siswa AIBS!' },
];

const waLink = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Halo AIBS, saya ingin mendaftar PPDB')}`;
---

<Layout
  title="PPDB"
  description="Penerimaan Peserta Didik Baru (PPDB) AIBS. Daftar online dan konsultasi via chat AI WhatsApp."
>
  <!-- Banner Gambar -->
  <Image src={bannerPpdb} alt="Banner PPDB SMK AIBS" class="w-full h-auto object-cover" />

  <section class="bg-brand-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-16 text-center">
      <h1 class="text-4xl font-extrabold">PPDB AIBS</h1>
      <p class="mt-4 text-brand-100 text-lg">Penerimaan Peserta Didik Baru telah dibuka. Daftar sekarang!</p>
      <a href={waLink} class="inline-block mt-6 bg-white text-brand-700 px-6 py-3 rounded-lg font-medium hover:bg-brand-50">
        Daftar via WhatsApp
      </a>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <h2 class="text-2xl font-bold text-gray-900 text-center mb-10">Alur Pendaftaran</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <div class="rounded-2xl border border-gray-100 p-6">
          <div class="w-10 h-10 rounded-full bg-brand-600 text-white flex items-center justify-center font-bold mb-4">{s.n}</div>
          <h3 class="font-semibold text-gray-900">{s.title}</h3>
          <p class="text-sm text-gray-600 mt-2">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
      <h2 class="text-2xl font-bold text-gray-900 text-center mb-8">Formulir Pendaftaran</h2>
      <form name="ppdb" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="bg-white rounded-2xl p-6 shadow-sm space-y-4">
        <input type="hidden" name="form-name" value="ppdb" />
        <p class="hidden"><label>Jangan isi: <input name="bot-field" /></label></p>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
          <input name="nama" required class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" name="email" required class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">No. WhatsApp</label>
            <input name="whatsapp" required class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Pilihan Jurusan</label>
          <select name="jurusan" required class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-brand-500">
            <option value="AI Programmer">AI Programmer</option>
            <option value="AI Bisnis Digital">AI Bisnis Digital</option>
            <option value="Keamanan Siber">Keamanan Siber</option>
          </select>
        </div>
        <button type="submit" class="w-full bg-brand-600 text-white py-3 rounded-lg font-medium hover:bg-brand-700">
          Kirim Pendaftaran
        </button>
      </form>
      <p class="text-center text-sm text-gray-500 mt-4">
        Butuh bantuan? <a href={waLink} class="text-brand-600 font-medium">Chat AI PPDB kami</a>.
      </p>
    </div>
  </section>
</Layout>